{% doc %}
  Renders the header's cart button, showing how many items are in the cart.

  @param {boolean} [compact] - Drop the "Cart" wording, for tight mobile rows
  @param {string} [classes] - Extra classes, typically responsive visibility

  @example
  {% render 'header-cart-link' %}
  {% render 'header-cart-link', compact: true, classes: 'md:hidden' %}
{% enddoc %}

<a
  href="{{ routes.cart_url }}"
  class="flex shrink-0 items-center gap-2 rounded-xs bg-[var(--header-accent)] px-4 py-2 text-sm font-medium text-white no-underline transition hover:opacity-90 {{ classes }}"
>
  {% # The accessible name is composed from the live text below rather than from
     # an `aria-label` with the count baked into it. The collection list adds to
     # the cart in the background and rewrites `[data-cart-count]` in place, and
     # an `aria-label` written at render time would still be announcing the old
     # total afterwards. %}
  <span class="sr-only">{{ 'cart.title' | t }}</span>

  {%- if compact -%}
    <span class="size-4 shrink-0 [&>svg]:size-full" aria-hidden="true">
      {{- 'icon-cart.svg' | inline_asset_content -}}
    </span>
  {%- else -%}
    <span aria-hidden="true">{{ 'cart.title' | t }}</span>
    <span aria-hidden="true">·</span>
  {%- endif -%}

  <span data-cart-count>{{ cart.item_count }}</span>
</a>
