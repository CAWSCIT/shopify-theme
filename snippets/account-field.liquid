{% doc %}
  Renders one labelled field in a customer account form.

  Handed `options`, it renders a select instead of an input — that's the country
  and province pair on the address form.

  @param {string} id - Unique id, so the label stays associated with the field
  @param {string} label - The field's visible label
  @param {string} [name] - The name the field posts under
  @param {string} [type] - Input type, defaults to text
  @param {string} [value] - The current value
  @param {string} [autocomplete] - Autocomplete hint for the browser
  @param {boolean} [required] - Marks the field required
  @param {boolean} [autofocus] - Focuses the field on load
  @param {string} [options] - Rendered option tags, which makes this a select
  @param {string} [attributes] - Extra attributes, typically a data hook
  @param {string} [classes] - Extra classes for the wrapper

  @example
  {% render 'account-field', id: 'email', label: 'Email', name: 'customer[email]', type: 'email' %}
{% enddoc %}

<div class="account-field {{ classes }}">
  <label class="account-label" for="{{ id }}">{{ label }}</label>

  {%- if options != blank -%}
    <div class="account-select-wrap">
      <select class="account-input account-select" id="{{ id }}" name="{{ name }}" {{ attributes }}>
        {{ options }}
      </select>
    </div>
  {%- else -%}
    <input
      class="account-input"
      id="{{ id }}"
      type="{{ type | default: 'text' }}"
      {% if name != blank %}
        name="{{ name }}"
      {% endif %}
      value="{{ value }}"
      {% if autocomplete != blank %}
        autocomplete="{{ autocomplete }}"
      {% endif %}
      {% if required %}
        required
      {% endif %}
      {% if autofocus %}
        autofocus
      {% endif %}
      {{ attributes }}
    >
  {%- endif -%}
</div>

{% stylesheet %}
  /*
   * Every customer form is built from this, so the whole account area agrees on
   * what a field looks like. Colours come from `--account-*` properties set by
   * the section around it, each with a fallback.
   */
  .account-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .account-label {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .account-input {
    width: 100%;
    padding: 0.875rem 1rem;
    font-size: 1rem;
    line-height: 1.25;
    color: inherit;
    background-color: var(--account-panel-bg, #ffffff);
    border: 1px solid var(--account-input-border, rgb(0 0 0 / 25%));
    border-radius: var(--style-border-radius-inputs, 2px);
  }

  .account-input:focus-visible {
    outline: 2px solid var(--account-accent, #0d463d);
    outline-offset: 1px;
  }

  /*
   * The native dropdown arrow sits differently in every browser, so it's
   * replaced with one drawn in `currentColor` — that way it follows the text
   * colour setting instead of needing a colour baked into an SVG.
   */
  .account-select-wrap {
    position: relative;
  }

  .account-select-wrap::after {
    position: absolute;
    top: 50%;
    right: 1.125rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-right: 1.5px solid currentcolor;
    border-bottom: 1.5px solid currentcolor;
    content: '';
    opacity: 0.55;
    pointer-events: none;
    transform: translateY(-70%) rotate(45deg);
  }

  .account-select {
    padding-right: 2.5rem;
    appearance: none;
  }
{% endstylesheet %}
