{%- liquid
  # Weights the theme's `font-light` … `font-bold` utilities can ask for, each
  # paired with its italic. `font_modify` returns nil when the merchant's chosen
  # font doesn't ship a variant, so every one is guarded — an unguarded nil
  # would emit a broken @font-face rule. Skipping instead lets the browser
  # synthesise the nearest weight it does have.
  #
  # Declaring a variant is cheap: browsers only download the ones actually
  # matched by rendered text, so this costs a few hundred bytes of inline CSS
  # rather than ten font requests.
  assign font_weights = '300,400,500,600,700' | split: ','
-%}

{% style %}
  {% # Loads all font variations with display: swap %}
  {%- for weight in font_weights -%}
    {%- assign font_variant = settings.type_primary_font | font_modify: 'weight', weight -%}

    {%- if font_variant != blank -%}
      {{ font_variant | font_face: font_display: 'swap' }}

      {%- assign font_variant_italic = font_variant | font_modify: 'style', 'italic' -%}
      {%- if font_variant_italic != blank -%}
        {{ font_variant_italic | font_face: font_display: 'swap' }}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {% # Prices render in Newsreader, which isn't in Shopify's font library — so
     # it can't come from a `font_picker` and is self-hosted out of `assets/`
     # instead. One variable file per subset covers the whole 200–800 weight
     # range, so `font-light` through `font-bold` are all real weights rather
     # than browser-synthesised ones.
     #
     # The `unicode-range` split is what Google Fonts serves: latin-ext is only
     # fetched when a page actually renders a character in it, which for prices
     # means currency symbols like ₹ that fall outside the latin block. %}
  @font-face {
    font-family: 'Newsreader';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url({{ 'newsreader-variable.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Newsreader';
    font-style: normal;
    font-weight: 200 800;
    font-display: swap;
    src: url({{ 'newsreader-variable-latin-ext.woff2' | asset_url }}) format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-price--family: Newsreader, serif;
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --icon-stroke-width: 1.5;
  }
{% endstyle %}
