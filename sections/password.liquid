{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  It's the whole page: the password layout carries no header or footer, so the
  section fills the viewport and centres the form in it.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<section
  class="password full-width bg-[var(--section-bg)] text-[var(--section-text)]"
  style="
    --section-bg: {{ section.settings.background_color }};
    --section-text: {{ section.settings.text_color }};
    --password-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }};
    --password-panel-bg: {{ section.settings.panel_background_color }};
    --password-input-border: {{ section.settings.text_color | color_modify: 'alpha', 0.25 }};
    --password-button-bg: {{ section.settings.button_background_color }};
    --password-button-text: {{ section.settings.button_text_color }};
    --password-error: {{ section.settings.error_color }};
    --password-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <div class="mx-auto flex w-full max-w-[26rem] flex-col items-center px-[var(--page-margin)] py-12 text-center">
    {%- if section.settings.logo != blank -%}
      {{
        section.settings.logo
        | image_url: width: 480
        | image_tag:
          widths: '120, 180, 240, 360, 480',
          sizes: 'var(--password-logo-width)',
          alt: shop.name,
          class: 'password__logo mb-8'
      }}
    {%- else -%}
      {% # No logo set, so the shop name stands in as a wordmark. The theme's
         # bundled logo is cut for the dark header and would disappear here. %}
      <p class="password__eyebrow mb-5">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="font-serif text-4xl leading-tight font-light text-balance lg:text-5xl">{{ 'password.title' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="password__message mt-4 text-base leading-relaxed">{{ shop.password_message }}</div>
    {%- endif -%}

    {% form 'storefront_password', class: 'password__form mt-8 w-full' %}
      {%- if form.errors -%}
        {{ form.errors | default_errors }}
      {%- endif -%}

      <label class="sr-only" for="{{ section.id }}-password">{{ 'password.password' | t }}</label>

      <div class="password__field">
        {% # Autofocused because it's the only thing on the page to do. %}
        <input
          class="password__input"
          id="{{ section.id }}-password"
          type="password"
          name="password"
          placeholder="{{ 'password.password' | t | escape }}"
          autocomplete="current-password"
          autofocus
        >

        <button type="submit" class="password__submit">{{ 'password.enter' | t }}</button>
      </div>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  /*
   * The page is one section on a layout with nothing else in it, so the height
   * is set here rather than left to the layout to hand down.
   */
  .password {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
  }

  .password__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .password__logo {
    width: var(--password-logo-width, 96px);
    height: auto;
    object-fit: contain;
  }

  .password__message {
    color: var(--password-muted, inherit);
  }

  /*
   * Links come out of the password message as bare `<a>` tags, so they can't
   * carry utility classes — they're styled from here instead.
   */
  .password__message a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .password__message a:hover,
  .password__message a:focus-visible {
    text-decoration: none;
  }

  .password__field {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .password__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.875rem 1rem;
    font-size: 1rem;
    line-height: 1.25;
    color: inherit;
    background-color: var(--password-panel-bg, #ffffff);
    border: 1px solid var(--password-input-border, rgb(0 0 0 / 25%));
    border-radius: var(--style-border-radius-inputs, 2px);
  }

  /*
   * The field is autofocused, so its ring is the first thing anyone sees —
   * worth having it in the theme's colour rather than the browser's blue.
   */
  .password__input:focus-visible {
    outline: 2px solid var(--password-button-bg, #0d463d);
    outline-offset: 1px;
  }

  .password__submit {
    flex: 0 0 auto;
    padding: 0.875rem 1.5rem;
    font: inherit;
    font-weight: 600;
    line-height: 1.25;
    color: var(--password-button-text, #ffffff);
    cursor: pointer;
    background-color: var(--password-button-bg, #0d463d);
    border: 0;
    border-radius: var(--style-border-radius-inputs, 2px);
    transition: opacity 150ms ease;
  }

  .password__submit:hover,
  .password__submit:focus-visible {
    opacity: 0.88;
  }

  /*
   * `default_errors` writes a bare `<ul class="errors">`, so this is the only
   * place its wording can be styled from.
   */
  .password__form .errors {
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--password-error, #a5361a);
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.password_logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 48,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "t:labels.panel_background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "t:labels.error_color",
      "default": "#A5361A"
    }
  ]
}
{% endschema %}
