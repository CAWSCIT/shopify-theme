{%- liquid
  # The panel is a solid block of colour, so an empty one would still paint a
  # bare stripe down the page — the whole section drops out unless the merchant
  # put something in it.
  assign has_heading = false
  if section.settings.heading != blank
    assign has_heading = true
  endif

  assign has_text = false
  if section.settings.text != blank
    assign has_text = true
  endif

  # A button with no destination is just a coloured rectangle, so both halves
  # have to be filled in before it renders.
  assign has_button = false
  if section.settings.button_label != blank
    if section.settings.button_url != blank
      assign has_button = true
    endif
  endif
-%}

{%- if has_heading or has_text or has_button -%}
  <section
    class="full-width bg-[var(--section-bg)]"
    style="
      --section-bg: {{ section.settings.section_background_color }};
      --panel-bg: {{ section.settings.background_color }};
      --panel-text: {{ section.settings.text_color }};
      --button-bg: {{ section.settings.button_background_color }};
      --button-text: {{ section.settings.button_text_color }};
    "
  >
    <div class="mx-auto max-w-[var(--page-width)] px-[var(--page-margin)] py-6 lg:py-8">
      <div class="information__panel flex flex-col gap-6 rounded-xs bg-[var(--panel-bg)] px-6 py-8 text-[var(--panel-text)] md:flex-row md:items-center md:justify-between md:gap-10 lg:px-10">
        {%- if has_heading or has_text -%}
          <div class="flex min-w-0 flex-col gap-2">
            {%- if has_heading -%}
              <h2 class="font-serif text-2xl leading-tight font-normal lg:text-3xl">{{ section.settings.heading }}</h2>
            {%- endif -%}

            {%- if has_text -%}
              <p class="text-base leading-snug">{{ section.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_button -%}
          <a
            href="{{ section.settings.button_url }}"
            class="inline-flex shrink-0 items-center justify-center self-start rounded-xs bg-[var(--button-bg)] px-6 py-3.5 text-sm font-medium text-[var(--button-text)] no-underline transition hover:opacity-90 md:self-auto"
          >
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /*
   * Links come out of the `inline_richtext` setting as bare `<a>` tags, so they
   * can't carry utility classes — they're styled from here instead. Underlined
   * by default, and the underline drops away on hover.
   */
  .information__panel p a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .information__panel p a:hover,
  .information__panel p a:focus-visible {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.information",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Ordering for your group?"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "Save your order and repeat it whenever the literature table runs low."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:info.button_optional",
      "default": "See saved orders"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "t:labels.section_background_color",
      "info": "t:info.section_background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.panel_background_color",
      "default": "#DCE5DB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:general.information"
    }
  ]
}
{% endschema %}
