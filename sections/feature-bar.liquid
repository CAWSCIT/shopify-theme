{%- liquid
  # The bar is a solid block of colour, so an empty one would still paint a
  # bare stripe down the page — the whole section drops out unless the merchant
  # put something in it.
  assign has_copy = false
  if section.settings.eyebrow != blank
    assign has_copy = true
  endif
  if section.settings.heading != blank
    assign has_copy = true
  endif
  if section.settings.text != blank
    assign has_copy = true
  endif

  # A button with no destination is just a coloured rectangle, so both halves
  # have to be filled in before it renders.
  assign has_button = false
  if section.settings.button_label != blank
    if section.settings.button_url != blank
      assign has_button = true
    endif
  endif

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  # Only the height of the thumbnail is pinned, so its width depends on the
  # shape of the image. Doubling the height covers anything up to a 2:1
  # landscape without the browser picking a source that's too small.
  assign media_sizes = section.settings.media_size | times: 2 | append: 'px'
-%}

{%- if has_copy or has_button or has_image -%}
  <section
    class="full-width bg-[var(--section-bg)]"
    style="
      --section-bg: {{ section.settings.section_background_color }};
      --bar-bg: {{ section.settings.background_color }};
      --bar-text: {{ section.settings.text_color }};
      --bar-eyebrow: {{ section.settings.eyebrow_color }};
      --bar-media-size: {{ section.settings.media_size }}px;
      --button-bg: {{ section.settings.button_background_color }};
      --button-text: {{ section.settings.button_text_color }};
    "
  >
    <div class="mx-auto max-w-[var(--page-width)] px-[var(--page-margin)] py-6 lg:py-8">
      <div class="feature-bar flex flex-col gap-6 rounded-xs bg-[var(--bar-bg)] px-6 py-8 text-[var(--bar-text)] md:flex-row md:items-center md:gap-8 lg:px-10">
        {%- if has_image -%}
          <div class="feature-bar__media">
            {{
              section.settings.image
              | image_url: width: 600
              | image_tag:
                widths: '150, 300, 450, 600',
                sizes: media_sizes,
                loading: 'lazy',
                class: 'feature-bar__image'
            }}
          </div>
        {%- endif -%}

        {%- if has_copy -%}
          <div class="flex min-w-0 flex-col gap-1">
            {%- if section.settings.eyebrow != blank -%}
              <p class="text-xs leading-none font-bold tracking-[0.14em] text-[var(--bar-eyebrow)] uppercase">
                {{- section.settings.eyebrow -}}
              </p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="font-serif text-3xl leading-tight font-normal lg:text-4xl">{{ section.settings.heading }}</h2>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <p class="text-base leading-snug">{{ section.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if has_button -%}
          <a
            href="{{ section.settings.button_url }}"
            class="inline-flex shrink-0 items-center justify-center self-start rounded-xs bg-[var(--button-bg)] px-6 py-3.5 text-sm font-medium text-[var(--button-text)] no-underline transition hover:opacity-90 md:ml-auto md:self-auto"
          >
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /*
   * Height is pinned and width is left to follow the image's own shape, so a
   * portrait book cover and a square keytag both sit on the same baseline
   * without either being cropped.
   */
  .feature-bar__media {
    flex: 0 0 auto;
    height: var(--bar-media-size, 128px);
  }

  /*
   * Unlayered, so this beats the `height: auto` that `critical.css` sets on
   * every image from `@layer reset`.
   */
  .feature-bar__image {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
  }

  /*
   * Links come out of the `inline_richtext` setting as bare `<a>` tags, so they
   * can't carry utility classes — they're styled from here instead. Underlined
   * by default, and the underline drops away on hover.
   */
  .feature-bar p a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .feature-bar p a:hover,
  .feature-bar p a:focus-visible {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.feature_bar",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow_optional",
      "default": "Back in stock"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Hope, Faith & Courage Volume 2"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "The reprint arrived. Sixty-one stories from members around the world."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:info.button_optional",
      "default": "Order a copy"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "header",
      "content": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "range",
      "id": "media_size",
      "label": "t:labels.media_size",
      "info": "t:info.bar_media_size",
      "min": 64,
      "max": 192,
      "step": 8,
      "unit": "px",
      "default": 128
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "t:labels.section_background_color",
      "info": "t:info.section_background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.panel_background_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "t:labels.eyebrow_color",
      "default": "#E7EEE9"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background_color",
      "default": "#C1521F"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:general.feature_bar"
    }
  ]
}
{% endschema %}
