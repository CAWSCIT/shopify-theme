{% comment %}
  This section is used in the customer account template to render the account
  dashboard — the orders placed and the address on file.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/customers-account
{% endcomment %}

{%- liquid
  assign page_title = 'customers.account.title' | t
-%}

{%- capture body -%}
  <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <p class="account__note text-base leading-snug">
      {{- 'customers.account.signed_in_as' | t: email: customer.email -}}
    </p>

    <a class="account__link text-base leading-snug" href="{{ routes.account_logout_url }}">
      {{- 'customers.account.sign_out' | t -}}
    </a>
  </div>

  <section class="mt-10">
    <h2 class="font-serif text-2xl leading-tight font-normal lg:text-3xl">
      {{- 'customers.account.orders' | t -}}
    </h2>

    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div class="account__table-wrap mt-4">
          <table class="account__table">
            <thead>
              <tr>
                <th scope="col">{{ 'customers.account.order_number' | t }}</th>
                <th scope="col">{{ 'customers.account.order_date' | t }}</th>
                <th scope="col">{{ 'customers.account.order_payment' | t }}</th>
                <th scope="col">{{ 'customers.account.order_fulfillment' | t }}</th>
                <th scope="col">{{ 'customers.account.order_total' | t }}</th>
              </tr>
            </thead>

            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <th scope="row" class="font-normal">
                    <a class="account__link" href="{{ order.customer_url }}">
                      <span class="sr-only">{{ 'customers.account.view_order' | t: name: order.name }}</span>
                      <span aria-hidden="true">{{ order.name }}</span>
                    </a>
                  </th>
                  <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td class="font-price">{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="account__pagination mt-6" aria-label="{{ 'collections.pagination' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="account__note mt-4 text-base leading-snug">{{ 'customers.account.no_orders' | t }}</p>

        <a class="account__submit mt-5" href="{{ routes.all_products_collection_url }}">
          {{- 'customers.account.start_shopping' | t -}}
        </a>
      {%- endif -%}
    {%- endpaginate -%}
  </section>

  <section class="mt-12">
    <h2 class="font-serif text-2xl leading-tight font-normal lg:text-3xl">
      {{- 'customers.account.addresses' | t -}}
    </h2>

    <div class="account__panel mt-4">
      {%- if customer.default_address != blank -%}
        <p class="account__section-title">{{ 'customers.account.default_address' | t }}</p>
        <address class="account__address mt-2">{{ customer.default_address | format_address }}</address>
      {%- else -%}
        <p class="account__note text-base leading-snug">{{ 'customers.account.no_address' | t }}</p>
      {%- endif -%}

      <a class="account__link mt-4 inline-block text-base leading-snug" href="{{ routes.account_addresses_url }}">
        {{- 'customers.account.manage_addresses' | t -}}
      </a>
    </div>
  </section>
{%- endcapture -%}

{% render 'account-page',
  settings: section.settings,
  title: page_title,
  body: body,
  width: '52rem'
%}

{% stylesheet %}
  /*
   * `default_pagination` emits bare `<span>`s and `<a>`s with no wrapper of
   * their own, so the spacing has to come from the container.
   */
  .account__pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .account__pagination a {
    color: inherit;
    text-decoration: none;
  }

  .account__pagination a:hover,
  .account__pagination a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .account__pagination .current {
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.account",
  "settings": [
    { "type": "header", "content": "t:general.colors" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#F9F8F4" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#1C2320" },
    { "type": "color", "id": "panel_background_color", "label": "t:labels.panel_background_color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "t:labels.accent_color", "default": "#0D463D" },
    { "type": "color", "id": "button_background_color", "label": "t:labels.button_background_color", "default": "#0D463D" },
    { "type": "color", "id": "button_text_color", "label": "t:labels.button_text_color", "default": "#FFFFFF" },
    { "type": "color", "id": "error_color", "label": "t:labels.error_color", "default": "#A5361A" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
