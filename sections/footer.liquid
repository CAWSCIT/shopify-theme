{%- liquid
  # The brand wording falls back to the store name set in the Shopify admin,
  # matching how the header resolves it.
  assign brand_name = shop.name

  # An unset menu, or one the merchant emptied, drops the columns entirely.
  assign footer_menu = section.settings.menu
  assign has_menu = false
  if footer_menu != blank and footer_menu.links.size > 0
    assign has_menu = true
  endif

  # The selector is only meaningful once the store sells into more than one market.
  assign show_localization = false
  if section.settings.show_country_selector
    if localization.available_countries.size > 1
      assign show_localization = true
    endif
  endif
-%}

<footer
  class="full-width bg-[var(--footer-bg)] text-[var(--footer-text)]"
  style="
    --footer-bg: {{ section.settings.background_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
    --footer-heading: {{ section.settings.text_color | color_modify: 'alpha', 0.75 }};
    --footer-rule: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    --footer-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <div class="mx-auto max-w-[var(--page-width)] px-[var(--page-margin)] pt-12 pb-8 lg:pt-14">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
      {% # Brand — logo, positioning line, and the office address %}
      <div>
        <a href="{{ routes.root_url }}" class="mb-7 block w-fit">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 256
              | image_tag:
                widths: '64, 128, 192, 256',
                sizes: 'var(--footer-logo-width)',
                alt: brand_name,
                loading: 'lazy',
                class: 'w-[var(--footer-logo-width)] shrink-0 object-contain'
            }}
          {%- else -%}
            <img
              src="{{ 'ca-logo-white.png' | asset_url }}"
              alt="{{ brand_name | escape }}"
              width="2017"
              height="2071"
              loading="lazy"
              class="w-[var(--footer-logo-width)] shrink-0 object-contain"
            >
          {%- endif -%}
        </a>

        {%- if section.settings.description != blank -%}
          <div class="mb-5 max-w-md leading-relaxed">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.address != blank -%}
          <div class="leading-relaxed text-[var(--footer-muted)]">{{ section.settings.address }}</div>
        {%- endif -%}
      </div>

      {% # Menu — each top-level link becomes a column, its children the links %}
      {%- if has_menu -%}
        <nav
          class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3"
          aria-label="{{ 'general.footer_navigation' | t }}"
        >
          {%- for link in footer_menu.links -%}
            <div>
              <h2 class="mb-5 text-xs font-semibold tracking-[0.14em] uppercase text-[var(--footer-heading)]">
                {{- link.title -}}
              </h2>

              {%- if link.links.size > 0 -%}
                <ul role="list" class="flex list-none flex-col gap-2.5 pl-0">
                  {%- for child_link in link.links -%}
                    <li>
                      <a
                        href="{{ child_link.url }}"
                        class="text-[var(--footer-text)] no-underline transition hover:underline hover:underline-offset-4"
                        {% if child_link.active %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- child_link.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="mt-12 border-t border-[var(--footer-rule)] pt-7 lg:mt-16">
      {%- if section.settings.tagline != blank -%}
        <p class="mb-5 font-serif leading-relaxed italic">{{ section.settings.tagline }}</p>
      {%- endif -%}

      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-sm text-[var(--footer-muted)]">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ brand_name }}</p>

        {%- if show_localization -%}
          {% form 'localization', class: 'contents' %}
            <label class="sr-only" for="footer-country">{{ 'general.country_region' | t }}</label>

            <select
              id="footer-country"
              name="country_code"
              class="footer-country-select cursor-pointer appearance-none rounded-none border-0 bg-transparent p-0 text-right text-inherit [&>option]:bg-page [&>option]:text-ink"
            >
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} &middot; {{ country.currency.iso_code }} {{ country.currency.symbol }}
                </option>
              {%- endfor -%}
            </select>

            <noscript>
              <button type="submit" class="ml-2 underline underline-offset-4">
                {{- 'general.update_country' | t -}}
              </button>
            </noscript>
          {% endform %}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  /*
   * `body` is a 100svh flex column but nothing inside it grows, so on short
   * pages (404, empty cart) the footer would float mid-viewport with the page
   * background showing beneath it. Pushing the footer's own section wrapper
   * down pins it to the bottom. Tailwind can't express this — the element that
   * needs the margin is the `.shopify-section` wrapper Shopify renders around
   * this file, which is outside the markup above.
   */
  .shopify-section-group-footer-group {
    margin-block-start: auto;
  }
{% endstylesheet %}

{% javascript %}
  // Delegated so it works no matter when the bundle runs, and keeps working
  // after the theme editor re-renders the section.
  document.addEventListener('change', (event) => {
    if (!event.target.matches('.footer-country-select')) return;
    event.target.form.submit();
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "t:general.brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.logo_fallback"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description",
      "default": "<p>The official shop of Cocaine Anonymous World Services. All orders are placed online.</p>"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "t:labels.address",
      "default": "<p>11460 North Cave Creek Road, Suite 12<br/>Phoenix, AZ 85020 &middot; 310.559.5833</p>"
    },
    {
      "type": "header",
      "content": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "info": "t:info.footer_menu"
    },
    {
      "type": "header",
      "content": "t:general.bottom_bar"
    },
    {
      "type": "inline_richtext",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "In the spirit of Tradition Six, C.A. is not allied with any sect, denomination, politics, organization or institution."
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:labels.show_country_selector",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#E5E2D9"
    }
  ]
}
{% endschema %}
