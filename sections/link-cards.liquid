{%- liquid
  # Stored as a select value, so it arrives as a string — `plus: 0` makes it a
  # number the grid can repeat.
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  assign columns_desktop = section.settings.columns_desktop
-%}

<section
  class="full-width bg-[var(--section-bg)] text-[var(--section-text)]"
  style="
    --section-bg: {{ section.settings.background_color }};
    --section-text: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_background_color }};
    --card-border: {{ section.settings.text_color | color_modify: 'alpha', 0.1 }};
    --card-media-bg: {{ section.settings.media_background_color }};
    --card-media-aspect: {{ section.settings.media_aspect_ratio }};
    --card-media-fit: {{ section.settings.media_fit }};
    --columns-mobile: {{ columns_mobile }};
    --columns-desktop: {{ columns_desktop }};
    --grid-gap: {{ section.settings.grid_gap }}px;
  "
>
  <div class="mx-auto max-w-[var(--page-width)] px-[var(--page-margin)] py-12 lg:py-16">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="flex max-w-3xl flex-col gap-3">
        {%- if section.settings.heading != blank -%}
          <h2 class="font-serif text-4xl leading-tight font-light lg:text-5xl">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="text-lg text-black my-3">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="link-cards__grid mt-8 lg:mt-10">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% stylesheet %}
  /*
   * The column counts are merchant settings, so the grid is built from custom
   * properties here rather than from utility classes — Tailwind can only emit
   * the classes it finds in the markup, and these values aren't known until the
   * page renders.
   */
  .link-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 2), minmax(0, 1fr));
    gap: var(--grid-gap, 20px);
  }

  @media (min-width: 48rem) {
    .link-cards__grid {
      grid-template-columns: repeat(var(--columns-desktop, 6), minmax(0, 1fr));
    }
  }

  /* Dimmed rather than a fixed grey, so it works on any section background. */
  .link-cards__subheading {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.link_cards",
  "max_blocks": 6,
  "blocks": [{ "type": "link-card" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Literature, keytags and medallions from the World Service Office."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "info": "t:info.subheading",
      "default": "Everything C.A. approved, in one place."
    },
    {
      "type": "header",
      "content": "t:general.card"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "t:labels.media_aspect_ratio",
      "default": "1 / 1",
      "options": [
        { "value": "4 / 3", "label": "t:options.aspect_ratio.landscape" },
        { "value": "1 / 1", "label": "t:options.aspect_ratio.square" },
        { "value": "3 / 4", "label": "t:options.aspect_ratio.portrait" }
      ]
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:labels.media_fit",
      "info": "t:info.media_fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "t:options.media_fit.cover" },
        { "value": "contain", "label": "t:options.media_fit.contain" }
      ]
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "t:labels.card_background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "media_background_color",
      "label": "t:labels.media_background_color",
      "default": "#EAE6DC"
    }
  ],
  "presets": [
    {
      "name": "t:general.link_cards",
      "blocks": [
        { "type": "link-card" },
        { "type": "link-card" },
        { "type": "link-card" },
        { "type": "link-card" },
        { "type": "link-card" },
        { "type": "link-card" }
      ]
    }
  ]
}
{% endschema %}
