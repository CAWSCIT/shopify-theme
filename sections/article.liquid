{% comment %}
  This section is used in the article template to render the article page — the
  post itself, and the comments under it when the blog has them turned on.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{%- liquid
  assign date = article.published_at | time_tag: format: 'date'

  # The comment form posts back to the article and Shopify redirects to
  # `#comments`, which is where the confirmation is shown.
  assign has_comments = false
  if blog.comments_enabled?
    assign has_comments = true
  endif
-%}

<section
  class="full-width bg-[var(--section-bg)] text-[var(--section-text)]"
  style="
    --section-bg: {{ section.settings.background_color }};
    --section-text: {{ section.settings.text_color }};
    --article-content-width: {{ section.settings.content_width }};
    --article-accent: {{ section.settings.accent_color }};
    --article-border: {{ section.settings.text_color | color_modify: 'alpha', 0.12 }};
    --article-input-border: {{ section.settings.text_color | color_modify: 'alpha', 0.25 }};
    --article-panel-bg: {{ section.settings.panel_background_color }};
    --article-error: {{ section.settings.error_color }};
    --prose-rule: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    --prose-button-bg: {{ section.settings.button_background_color }};
    --prose-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="mx-auto max-w-[var(--article-content-width)] px-[var(--page-margin)] py-8 lg:py-12">
    {%- if section.settings.show_breadcrumb -%}
      <nav aria-label="{{ 'general.breadcrumb.label' | t }}">
        <ol role="list" class="article__breadcrumb flex list-none flex-wrap items-center gap-2 pl-0 text-sm leading-snug">
          <li><a class="article__breadcrumb-link" href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="article__breadcrumb-link" href="{{ blog.url }}">{{ blog.title }}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{{ article.title }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <article>
      <header class="mt-4">
        <h1 class="font-serif text-4xl leading-tight font-light text-balance lg:text-5xl">{{ article.title }}</h1>

        {%- if section.settings.show_meta -%}
          <p class="article__meta mt-3 text-sm leading-snug">
            {{- 'blog.article_metadata_html' | t: date: date, author: article.author -}}
          </p>
        {%- endif -%}
      </header>

      {%- if section.settings.show_image -%}
        {%- if article.image != blank -%}
          <div class="article__media mt-8">
            {{
              article.image
              | image_url: width: 1600
              | image_tag:
                widths: '600, 800, 1200, 1600',
                sizes: '(min-width: 64rem) 48rem, 100vw',
                class: 'article__image'
            }}
          </div>
        {%- endif -%}
      {%- endif -%}

      {% render 'rich-text', content: article.content, classes: 'mt-8' %}

      {%- if section.settings.show_tags -%}
        {%- if article.tags.size > 0 -%}
          <nav class="mt-10 flex flex-wrap gap-2" aria-label="{{ 'blog.tags' | t }}">
            {%- for tag in article.tags -%}
              <a class="article__tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endif -%}

      <p class="mt-10">
        <a class="article__back" href="{{ blog.url }}">{{ 'blog.all_articles' | t }}</a>
      </p>
    </article>

    {%- if has_comments -%}
      <section class="article__comments mt-12" id="comments">
        <h2 class="font-serif text-2xl leading-tight font-normal lg:text-3xl">
          {{- 'blog.comment_count' | t: count: article.comments_count -}}
        </h2>

        {%- if article.comments_count > 0 -%}
          {%- paginate article.comments by 10 -%}
            <ul role="list" class="article__comment-list mt-6 list-none pl-0">
              {%- for comment in article.comments -%}
                <li class="article__comment">
                  <p class="article__comment-meta text-sm leading-snug">
                    {%- assign comment_date = comment.created_at | time_tag: format: 'date' -%}
                    {{ 'blog.article_metadata_html' | t: date: comment_date, author: comment.author }}
                  </p>

                  <div class="article__comment-body mt-2 text-base leading-relaxed">{{ comment.content }}</div>
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <nav class="article__pagination mt-6" aria-label="{{ 'collections.pagination' | t }}">
                {{ paginate | default_pagination: anchor: 'comments' }}
              </nav>
            {%- endif -%}
          {%- endpaginate -%}
        {%- endif -%}

        {% form 'new_comment', article, class: 'article__form mt-10' %}
          <h3 class="font-serif text-xl leading-tight font-normal">{{ 'blog.comment_form_title' | t }}</h3>

          {%- if form.posted_successfully? -%}
            <p class="article__notice mt-4" role="status">
              {%- if blog.moderated? -%}
                {{- 'blog.comment_pending' | t -}}
              {%- else -%}
                {{- 'blog.comment_posted' | t -}}
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="article__errors mt-4">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="article__fields mt-5">
            <div class="article__field">
              <label class="article__label" for="{{ section.id }}-author">{{ 'blog.comment_form_name' | t }}</label>
              <input
                class="article__input"
                id="{{ section.id }}-author"
                type="text"
                name="comment[author]"
                value="{{ form.author }}"
                autocomplete="name"
                required
              >
            </div>

            <div class="article__field">
              <label class="article__label" for="{{ section.id }}-email">{{ 'blog.comment_form_email' | t }}</label>
              <input
                class="article__input"
                id="{{ section.id }}-email"
                type="email"
                name="comment[email]"
                value="{{ form.email }}"
                autocomplete="email"
                required
              >
            </div>
          </div>

          <div class="article__field mt-4">
            <label class="article__label" for="{{ section.id }}-body">{{ 'blog.comment_form_body' | t }}</label>
            <textarea class="article__input article__textarea" id="{{ section.id }}-body" name="comment[body]" rows="5" required>
              {{- form.body -}}
            </textarea>
          </div>

          {%- if blog.moderated? -%}
            <p class="article__note mt-3 text-sm leading-snug">{{ 'blog.comment_moderated' | t }}</p>
          {%- endif -%}

          <button type="submit" class="article__submit mt-5">{{ 'blog.comment_form_submit' | t }}</button>
        {% endform %}
      </section>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .article__breadcrumb,
  .article__meta,
  .article__comment-meta,
  .article__note {
    opacity: 0.7;
  }

  .article__breadcrumb-link,
  .article__back {
    color: inherit;
    text-decoration: none;
  }

  .article__breadcrumb-link:hover,
  .article__breadcrumb-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article__back {
    font-weight: 500;
    color: var(--article-accent, #0d463d);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article__back:hover,
  .article__back:focus-visible {
    text-decoration: none;
  }

  .article__media {
    overflow: hidden;
    background-color: var(--article-panel-bg, #ffffff);
    border-radius: 2px;
  }

  /*
   * Unlayered, so this beats the `height: auto` that `critical.css` sets on
   * every image from `@layer reset`.
   */
  .article__image {
    width: 100%;
    height: auto;
  }

  .article__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    line-height: 1.25;
    color: inherit;
    text-decoration: none;
    background-color: var(--article-panel-bg, #ffffff);
    border: 1px solid var(--article-border, rgb(0 0 0 / 12%));
    border-radius: 999px;
  }

  .article__tag:hover,
  .article__tag:focus-visible {
    border-color: var(--article-accent, #0d463d);
  }

  .article__comments {
    padding-top: 2.5rem;
    border-top: 1px solid var(--article-border, rgb(0 0 0 / 12%));
  }

  .article__comment + .article__comment {
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--article-border, rgb(0 0 0 / 12%));
  }

  /* Two fields side by side from `sm` up, stacked below it. */
  .article__fields {
    display: grid;
    gap: 1rem;
  }

  @media screen and (min-width: 40rem) {
    .article__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .article__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .article__label {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article__input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    line-height: 1.4;
    color: inherit;
    background-color: var(--article-panel-bg, #ffffff);
    border: 1px solid var(--article-input-border, rgb(0 0 0 / 25%));
    border-radius: var(--style-border-radius-inputs, 2px);
  }

  .article__input:focus-visible {
    outline: 2px solid var(--article-accent, #0d463d);
    outline-offset: 1px;
  }

  .article__textarea {
    resize: vertical;
  }

  .article__notice {
    color: var(--article-accent, #0d463d);
  }

  /*
   * `default_errors` writes a bare `<ul class="errors">`, so this is the only
   * place its wording can be styled from.
   */
  .article__errors .errors {
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--article-error, #a5361a);
    list-style: none;
  }

  .article__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    font: inherit;
    font-weight: 600;
    line-height: 1.25;
    color: var(--prose-button-text, #ffffff);
    cursor: pointer;
    background-color: var(--prose-button-bg, #0d463d);
    border: 0;
    border-radius: var(--style-border-radius-inputs, 2px);
    transition: opacity 150ms ease;
  }

  .article__submit:hover,
  .article__submit:focus-visible {
    opacity: 0.88;
  }

  /*
   * `default_pagination` emits bare `<span>`s and `<a>`s with no wrapper of
   * their own, so the spacing has to come from the container.
   */
  .article__pagination {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.875rem;
  }

  .article__pagination a {
    color: inherit;
    text-decoration: none;
  }

  .article__pagination a:hover,
  .article__pagination a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article__pagination .current {
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:labels.show_breadcrumb",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:labels.content_width",
      "info": "t:info.content_width",
      "default": "48rem",
      "options": [
        { "value": "40rem", "label": "t:options.content_width.narrow" },
        { "value": "48rem", "label": "t:options.content_width.medium" },
        { "value": "60rem", "label": "t:options.content_width.wide" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "t:labels.show_meta",
      "info": "t:info.blog_meta",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "info": "t:info.article_tags",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "panel_background_color",
      "label": "t:labels.panel_background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:labels.accent_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "t:labels.error_color",
      "default": "#A5361A"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
