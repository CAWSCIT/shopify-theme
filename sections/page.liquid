{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  Everything below the title comes out of the page editor as bare HTML, so none
  of it can carry a utility class. It's handed to the `rich-text` snippet, which
  carries the theme's prose styling.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<section
  class="full-width bg-[var(--section-bg)] text-[var(--section-text)]"
  style="
    --section-bg: {{ section.settings.background_color }};
    --section-text: {{ section.settings.text_color }};
    --page-content-width: {{ section.settings.content_width }};
    --page-padding: {{ section.settings.padding }}px;
    --prose-rule: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
    --prose-button-bg: {{ section.settings.button_background_color }};
    --prose-button-text: {{ section.settings.button_text_color }};
  "
>
  {% # Narrower than the theme's page width: a column of prose is easier to read
     # at a shorter measure than a grid of products is. %}
  <div class="mx-auto max-w-[var(--page-content-width)] px-[var(--page-margin)] py-[var(--page-padding)]">
    {%- if section.settings.show_title -%}
      <h1 class="page__title font-serif text-4xl leading-tight font-light lg:text-5xl">{{ page.title }}</h1>
    {%- endif -%}

    {%- if page.content != blank -%}
      {% render 'rich-text', content: page.content, classes: 'page__content' %}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .page__title + .page__content {
    margin-top: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:labels.show_title",
      "info": "t:info.show_title",
      "default": true
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:labels.content_width",
      "info": "t:info.content_width",
      "default": "48rem",
      "options": [
        { "value": "40rem", "label": "t:options.content_width.narrow" },
        { "value": "48rem", "label": "t:options.content_width.medium" },
        { "value": "60rem", "label": "t:options.content_width.wide" }
      ]
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:labels.padding",
      "info": "t:info.page_padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background_color",
      "info": "t:info.page_button",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#FFFFFF"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
