{%- liquid
  # The catalog row highlights the collection the shopper is currently browsing.
  assign active_collection_handle = ''
  if template.name == 'collection' and collection != blank
    assign active_collection_handle = collection.handle
  endif

  # The brand wording falls back to the store name set in the Shopify admin.
  assign brand_name = section.settings.brand_name | default: shop.name

  # Account goes to the customer dashboard when signed in, to login when not.
  if customer
    assign account_url = routes.account_url
  else
    assign account_url = routes.account_login_url
  endif
-%}

<header
  class="full-width bg-[var(--header-bg)] text-[var(--header-text)]"
  style="
    --header-bg: {{ section.settings.background_color }};
    --header-nav-bg: {{ section.settings.nav_background_color }};
    --header-text: {{ section.settings.text_color }};
    --header-accent: {{ section.settings.accent_color }};
    --header-search-bg: {{ section.settings.background_color | color_lighten: 8 }};
    --header-logo-width: {{ section.settings.logo_width }}px;
  "
>
  {% # Row 1 — brand, catalog search, account, cart %}
  <div class="relative mx-auto flex max-w-[var(--page-width)] items-center justify-between gap-4 px-[var(--page-margin)] py-3 lg:gap-8 lg:py-4">
    <a
      href="{{ routes.root_url }}"
      class="flex min-w-0 items-center gap-3 text-[var(--header-text)] no-underline lg:gap-4"
    >
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 192
          | image_tag:
            widths: '48, 96, 144, 192',
            sizes: 'var(--header-logo-width)',
            alt: brand_name,
            loading: 'eager',
            class: 'w-[var(--header-logo-width)] shrink-0 object-contain'
        }}
      {%- else -%}
        <img
          src="{{ 'ca-logo-white.png' | asset_url }}"
          alt="{{ brand_name | escape }}"
          width="192"
          height="192"
          loading="eager"
          class="w-[var(--header-logo-width)] shrink-0 object-contain"
        >
      {%- endif -%}

      <span class="min-w-0">
        <span class="block truncate font-serif text-lg leading-tight lg:text-2xl font-light">{{ brand_name }}</span>
        {%- if section.settings.tagline != blank -%}
          <span class="mt-0.5 block truncate text-[0.625rem] leading-tight tracking-[0.18em] uppercase opacity-75 lg:text-[0.75rem] font-medium">
            {{- section.settings.tagline -}}
          </span>
        {%- endif -%}
      </span>
    </a>

    <div class="hidden items-center gap-4 md:flex lg:gap-5">
      {%- if section.settings.show_search -%}
        {% render 'header-search', id: 'header-search-desktop', classes: 'w-44 lg:w-64 xl:w-80' %}
      {%- endif -%}

      <a
        href="{{ account_url }}"
        class="shrink-0 text-sm text-white no-underline opacity-90 transition hover:opacity-100"
      >
        {{- 'customers.account' | t -}}
      </a>

      {% render 'header-cart-link' %}
    </div>

    <div class="flex shrink-0 items-center gap-2 md:hidden">
      {% render 'header-cart-link', compact: true %}

      <details class="group" scroll-lock>
        <summary
          aria-label="{{ 'general.accessibility.open_menu' | t }}"
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-xs [&::-webkit-details-marker]:hidden"
        >
          <span class="size-5 group-open:hidden [&>svg]:size-full">{{ 'icon-menu.svg' | inline_asset_content }}</span>
          <span class="hidden size-5 group-open:block [&>svg]:size-full">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </summary>

        <div class="absolute inset-x-[var(--page-margin)] top-full z-50 mt-3 flex flex-col gap-3 rounded-xs bg-[var(--header-bg)] p-4 shadow-lg ring-1 ring-white/10">
          {%- if section.settings.show_search -%}
            {% render 'header-search', id: 'header-search-mobile', classes: 'w-full' %}
          {%- endif -%}

          <a
            href="{{ account_url }}"
            class="rounded-xs px-2 py-2 text-sm text-[var(--header-text)] no-underline transition hover:bg-white/10"
          >
            {{- 'customers.account' | t -}}
          </a>
        </div>
      </details>
    </div>
  </div>

  {% # Row 2 — catalog collections with their product counts %}
  {%- if section.blocks.size > 0 -%}
    <div class="bg-[var(--header-nav-bg)]">
      <nav
        class="header__catalog mx-auto flex max-w-[var(--page-width)] items-stretch gap-6 overflow-x-auto px-[var(--page-margin)] lg:gap-8"
        tabindex="0"
        aria-label="{{ 'general.navigation.catalog' | t }}"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign nav_url = blank
            assign nav_label = block.settings.label
            assign nav_description = blank
            assign is_active = false

            case block.type
              when 'collection'
                assign nav_collection = block.settings.collection
                if nav_collection != blank
                  assign nav_url = nav_collection.url
                  assign nav_label = nav_label | default: nav_collection.title
                  if block.settings.count_label != 'none'
                    capture count_key
                      echo 'general.navigation.count_'
                      echo block.settings.count_label
                    endcapture
                    assign nav_description = count_key | t: count: nav_collection.all_products_count
                  endif
                  if nav_collection.handle == active_collection_handle
                    assign is_active = true
                  endif
                endif
              when 'link'
                assign nav_url = block.settings.url
                assign nav_description = block.settings.description
                if nav_url == request.path
                  assign is_active = true
                endif
            endcase
          -%}

          {%- if nav_url != blank and nav_label != blank -%}
            <a
              href="{{ nav_url }}"
              class="flex shrink-0 flex-col justify-center border-b-[4px] py-3 text-[var(--header-text)] no-underline  md:px-6 {% if is_active %}border-[var(--header-accent)]{% else %}border-transparent hover:border-[var(--header-accent)]{% endif %}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <span class="text-[0.875rem] font-medium">{{ nav_label }}</span>
              {%- if nav_description != blank -%}
                <span class="text-xs leading-tight opacity-70">{{ nav_description }}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  {%- endif -%}
</header>

{% stylesheet %}
  /*
   * The catalog row scrolls sideways when the collections don't fit — which on
   * a phone is nearly always. The scrollbar itself would sit on top of the
   * active-item underline, so it's hidden and replaced by the edge fades below.
   */
  .header__catalog {
    scrollbar-width: none;
    scroll-snap-type: inline proximity;
    /* Keep a sideways swipe inside the bar: no page scroll, no back-navigation. */
    overscroll-behavior-inline: contain;
    /* Snapped items line up with the page margin rather than the viewport edge. */
    scroll-padding-inline: var(--page-margin);
  }

  .header__catalog::-webkit-scrollbar {
    display: none;
  }

  .header__catalog > * {
    scroll-snap-align: start;
  }

  /*
   * Fade whichever edge still has collections behind it, so it's obvious the row
   * scrolls. `data-overflow` is maintained by the script below; with JS off the
   * attribute is never set and the row simply renders unfaded.
   */
  .header__catalog[data-overflow] {
    -webkit-mask-image: var(--catalog-fade);
    mask-image: var(--catalog-fade);
  }

  .header__catalog[data-overflow='start'] {
    --catalog-fade: linear-gradient(to right, transparent, #000 2.5rem);
  }

  .header__catalog[data-overflow='end'] {
    --catalog-fade: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }

  .header__catalog[data-overflow='both'] {
    --catalog-fade: linear-gradient(
      to right,
      transparent,
      #000 2.5rem,
      #000 calc(100% - 2.5rem),
      transparent
    );
  }
{% endstylesheet %}

{% javascript %}
  // Keeps the catalog row's edge fades in sync with its scroll position, and
  // brings the collection you're currently browsing into view on load.
  (() => {
    function setupCatalog(nav) {
      if (nav.dataset.catalogReady) return;
      nav.dataset.catalogReady = 'true';

      function update() {
        const max = nav.scrollWidth - nav.clientWidth;

        // Nothing to scroll: drop the attribute so no mask is applied at all.
        if (max <= 1) {
          delete nav.dataset.overflow;
          return;
        }

        // 1px of slack absorbs sub-pixel scroll positions on zoomed displays.
        const atStart = nav.scrollLeft <= 1;
        const atEnd = nav.scrollLeft >= max - 1;

        if (atStart) {
          nav.dataset.overflow = 'end';
        } else if (atEnd) {
          nav.dataset.overflow = 'start';
        } else {
          nav.dataset.overflow = 'both';
        }
      }

      nav.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);

      // Re-measure once webfonts land, since they change the row's width.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(update);
      }

      // Centre the active collection. Adjusting scrollLeft by the measured delta
      // keeps the scroll local to this row — scrollIntoView would also pan any
      // scrollable ancestor, which on a phone means jumping the whole page.
      const current = nav.querySelector('[aria-current="page"]');

      if (current) {
        const navBox = nav.getBoundingClientRect();
        const itemBox = current.getBoundingClientRect();
        nav.scrollLeft += itemBox.left - navBox.left - (navBox.width - itemBox.width) / 2;
      }

      update();
    }

    function init() {
      document.querySelectorAll('.header__catalog').forEach(setupCatalog);
    }

    init();

    // The theme editor re-renders the section on every settings change.
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label",
          "info": "t:info.label_fallback"
        },
        {
          "type": "select",
          "id": "count_label",
          "label": "t:labels.count_label",
          "default": "products",
          "options": [
            { "value": "products", "label": "t:options.count_label.products" },
            { "value": "titles", "label": "t:options.count_label.titles" },
            { "value": "items", "label": "t:options.count_label.items" },
            { "value": "none", "label": "t:options.count_label.none" }
          ]
        }
      ]
    },
    {
      "type": "link",
      "name": "t:general.link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:labels.link_url"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:labels.description"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.logo_fallback"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "t:labels.brand_name",
      "info": "t:info.brand_name_fallback"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "t:labels.tagline",
      "default": "World Service Shop"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "nav_background_color",
      "label": "t:labels.nav_background_color",
      "default": "#0A3B33"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:labels.accent_color",
      "default": "#B7411F"
    }
  ]
}
{% endschema %}
