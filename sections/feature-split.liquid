{%- liquid
  # The panel is a solid block of colour, so an empty one would still paint a
  # bare stripe down the page — the whole section drops out unless the merchant
  # put something in it.
  assign has_copy = false
  if section.settings.eyebrow != blank
    assign has_copy = true
  endif
  if section.settings.heading != blank
    assign has_copy = true
  endif
  if section.settings.text != blank
    assign has_copy = true
  endif

  # A button with no destination is just a coloured rectangle, so both halves
  # have to be filled in before it renders.
  assign has_button = false
  if section.settings.button_label != blank
    if section.settings.button_url != blank
      assign has_button = true
    endif
  endif

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif

  # The media column only takes half the panel once the two sit side by side.
  assign media_sizes = '(min-width: 48rem) 50vw, 100vw'
-%}

{%- if has_copy or has_button or has_image -%}
  <section
    class="full-width bg-[var(--section-bg)]"
    style="
      --section-bg: {{ section.settings.section_background_color }};
      --panel-bg: {{ section.settings.background_color }};
      --panel-text: {{ section.settings.text_color }};
      --panel-eyebrow: {{ section.settings.eyebrow_color }};
      --button-bg: {{ section.settings.button_background_color }};
      --button-text: {{ section.settings.button_text_color }};
    "
  >
    <div class="mx-auto max-w-[var(--page-width)] px-[var(--page-margin)] py-6 lg:py-8">
      <div class="feature-split {{ section.settings.image_position }} overflow-hidden rounded-xs bg-[var(--panel-bg)] text-[var(--panel-text)]">
        <div class="feature-split__content flex flex-col items-start gap-4 px-6 py-10 lg:px-12 lg:py-14">
          {%- if section.settings.eyebrow != blank -%}
            <p class="text-xs leading-none font-bold tracking-[0.14em] text-[var(--panel-eyebrow)] uppercase">
              {{- section.settings.eyebrow -}}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="font-serif text-4xl leading-tight font-normal lg:text-5xl">{{ section.settings.heading }}</h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <p class="max-w-[46ch] text-base leading-relaxed lg:text-lg">{{ section.settings.text }}</p>
          {%- endif -%}

          {%- if has_button -%}
            <a
              href="{{ section.settings.button_url }}"
              class="mt-2 inline-flex shrink-0 items-center justify-center rounded-xs bg-[var(--button-bg)] px-6 py-3.5 text-sm font-medium text-[var(--button-text)] no-underline transition hover:opacity-90"
            >
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
        </div>

        {%- if has_image -%}
          <div class="feature-split__media">
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                widths: '400, 600, 800, 1200, 1600',
                sizes: media_sizes,
                loading: 'lazy',
                class: 'feature-split__image'
            }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /*
   * Stacked on a phone, side by side from tablet up. The media half is a plain
   * grid column rather than a background image so it can be reordered and so
   * the browser still gets a real `srcset` to pick from.
   */
  .feature-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .feature-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .feature-split--media-left .feature-split__content {
      order: 2;
    }

    .feature-split--media-left .feature-split__media {
      order: 1;
    }
  }

  /*
   * On a phone the image has no text beside it to borrow height from, so it
   * needs a floor of its own or it collapses to nothing.
   */
  .feature-split__media {
    min-height: 220px;
  }

  /*
   * Unlayered, so this beats the `height: auto` that `critical.css` sets on
   * every image from `@layer reset`. Cropped rather than contained — the image
   * has to fill its half of the panel however tall the copy beside it runs.
   */
  .feature-split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * Links come out of the `inline_richtext` setting as bare `<a>` tags, so they
   * can't carry utility classes — they're styled from here instead. Underlined
   * by default, and the underline drops away on hover.
   */
  .feature-split__content p a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .feature-split__content p a:hover,
  .feature-split__content p a:focus-visible {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.feature_split",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow_optional",
      "default": "Order by December 10"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Christmas delivery cutoff"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "Anything ordered after the tenth may not arrive before the holiday. If your group hands out tags at a Christmas meeting, order early."
    },
    {
      "type": "header",
      "content": "t:general.button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:info.button_optional",
      "default": "Shop keytags"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:labels.link_url"
    },
    {
      "type": "header",
      "content": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "info": "t:info.image_position",
      "default": "feature-split--media-right",
      "options": [
        { "value": "feature-split--media-left", "label": "t:options.alignment.left" },
        { "value": "feature-split--media-right", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "t:labels.section_background_color",
      "info": "t:info.section_background_color",
      "default": "#F9F8F4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.panel_background_color",
      "default": "#EAE6DC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#1C2320"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "t:labels.eyebrow_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "t:labels.button_background_color",
      "default": "#0D463D"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:labels.button_text_color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:general.feature_split"
    }
  ]
}
{% endschema %}
