{% comment %}
  This section is used in the customer reset password template, which is where
  the link in a password reset email lands.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/customers-reset_password
{% endcomment %}

{%- liquid
  assign label_password = 'customers.reset_password.password' | t
  assign label_confirm = 'customers.reset_password.confirm' | t
  assign page_title = 'customers.reset_password.title' | t
  assign page_intro = 'customers.reset_password.note' | t
-%}

{%- capture body -%}
  {% form 'reset_customer_password', class: 'mt-8' %}
    {%- if form.errors -%}
      <div class="account__errors mb-4">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    {% render 'account-field',
      id: 'reset-password',
      label: label_password,
      name: 'customer[password]',
      type: 'password',
      autocomplete: 'new-password',
      required: true,
      autofocus: true
    %}

    {% render 'account-field',
      id: 'reset-password-confirm',
      label: label_confirm,
      name: 'customer[password_confirmation]',
      type: 'password',
      autocomplete: 'new-password',
      required: true,
      classes: 'mt-4'
    %}

    <button type="submit" class="account__submit account__submit--full mt-6">
      {{- 'customers.reset_password.submit' | t -}}
    </button>
  {% endform %}
{%- endcapture -%}

{% render 'account-page',
  settings: section.settings,
  title: page_title,
  intro: page_intro,
  body: body
%}

{% schema %}
{
  "name": "t:general.reset_password",
  "settings": [
    { "type": "header", "content": "t:general.colors" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#F9F8F4" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#1C2320" },
    { "type": "color", "id": "panel_background_color", "label": "t:labels.panel_background_color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "t:labels.accent_color", "default": "#0D463D" },
    { "type": "color", "id": "button_background_color", "label": "t:labels.button_background_color", "default": "#0D463D" },
    { "type": "color", "id": "button_text_color", "label": "t:labels.button_text_color", "default": "#FFFFFF" },
    { "type": "color", "id": "error_color", "label": "t:labels.error_color", "default": "#A5361A" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
