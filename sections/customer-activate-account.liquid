{% comment %}
  This section is used in the customer activate account template, which is
  where the link in an account invitation lands.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/customers-activate_account
{% endcomment %}

{%- liquid
  assign label_password = 'customers.activate_account.password' | t
  assign label_confirm = 'customers.activate_account.confirm' | t
  assign page_title = 'customers.activate_account.title' | t
  assign page_intro = 'customers.activate_account.note' | t
-%}

{%- capture body -%}
  {% form 'activate_customer_password', class: 'mt-8' %}
    {%- if form.errors -%}
      <div class="account__errors mb-4">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    {% render 'account-field',
      id: 'activate-password',
      label: label_password,
      name: 'customer[password]',
      type: 'password',
      autocomplete: 'new-password',
      required: true,
      autofocus: true
    %}

    {% render 'account-field',
      id: 'activate-password-confirm',
      label: label_confirm,
      name: 'customer[password_confirmation]',
      type: 'password',
      autocomplete: 'new-password',
      required: true,
      classes: 'mt-4'
    %}

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button type="submit" class="account__submit">{{ 'customers.activate_account.submit' | t }}</button>

      {% # Declining is a real choice on an invitation, so it's on the page —
         # quietly, as the thing you probably didn't come here to do. %}
      <button type="submit" name="decline" class="account__submit account__submit--quiet">
        {{- 'customers.activate_account.decline' | t -}}
      </button>
    </div>
  {% endform %}
{%- endcapture -%}

{% render 'account-page',
  settings: section.settings,
  title: page_title,
  intro: page_intro,
  body: body
%}

{% schema %}
{
  "name": "t:general.activate_account",
  "settings": [
    { "type": "header", "content": "t:general.colors" },
    { "type": "color", "id": "background_color", "label": "t:labels.background_color", "default": "#F9F8F4" },
    { "type": "color", "id": "text_color", "label": "t:labels.text_color", "default": "#1C2320" },
    { "type": "color", "id": "panel_background_color", "label": "t:labels.panel_background_color", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "t:labels.accent_color", "default": "#0D463D" },
    { "type": "color", "id": "button_background_color", "label": "t:labels.button_background_color", "default": "#0D463D" },
    { "type": "color", "id": "button_text_color", "label": "t:labels.button_text_color", "default": "#FFFFFF" },
    { "type": "color", "id": "error_color", "label": "t:labels.error_color", "default": "#A5361A" }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
