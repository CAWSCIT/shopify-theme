[
  {
    "name": "theme_info",
    "theme_name": "CAWSO",
    "theme_version": "0.1.0",
    "theme_author": "Kalob Taulien",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "brand_logo",
        "label": "t:labels.logo",
        "info": "t:info.brand_logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "open_sans_n4",
        "label": "t:general.primary",
        "info": "t:info.primary_font_weights"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      {
        "type": "image_picker",
        "id": "social_image",
        "label": "t:labels.social_image",
        "info": "t:info.social_image"
      },
      {
        "type": "header",
        "content": "t:general.social_profiles",
        "info": "t:info.social_profiles"
      },
      {
        "type": "url",
        "id": "social_instagram_url",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_facebook_url",
        "label": "t:labels.social_facebook"
      },
      {
        "type": "url",
        "id": "social_x_url",
        "label": "t:labels.social_x"
      },
      {
        "type": "url",
        "id": "social_youtube_url",
        "label": "t:labels.social_youtube"
      },
      {
        "type": "url",
        "id": "social_tiktok_url",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_pinterest_url",
        "label": "t:labels.social_pinterest"
      },
      {
        "type": "url",
        "id": "social_linkedin_url",
        "label": "t:labels.social_linkedin"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
