{% comment %}
  The page a gift card recipient lands on, printed or kept on a phone.

  It renders its own document — the layout tag below is set to none, so there's
  no header, footer or theme layout around it — and the palette is written out
  here rather than coming from section settings. The values match what every
  other section defaults to.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/gift-card
{% endcomment %}

{% layout none %}

{%- liquid
  assign is_spent = false
  if gift_card.enabled == false or gift_card.expired
    assign is_spent = true
  endif

  # `initial_value` only says something worth reading once part of the card has
  # been spent — on an untouched card it's the same figure twice.
  assign is_part_used = false
  if gift_card.balance < gift_card.initial_value
    assign is_part_used = true
  endif

  # Built here because a filter argument can't itself be filtered.
  assign initial_value = gift_card.initial_value | money
-%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Tailwind utilities, compiled by Vite from src/styles/tailwind.css %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # A template can't carry a stylesheet tag — that's for sections, blocks
       # and snippets — so the page's own CSS is inlined here. It's one page and
       # the only thing loading this, so inline is cheaper than a request too.
       #
       # Nothing in a comment may be written as a Liquid tag: an inline comment
       # ends at the first closing brace pair, whatever is around it. %}
    {% style %}
      .gift-card {
        --gift-card-bg: #f9f8f4;
        --gift-card-text: #1c2320;
        --gift-card-accent: #0d463d;
        --gift-card-panel-bg: #ffffff;
        --gift-card-border: rgb(28 35 32 / 12%);
        --gift-card-error: #a5361a;

        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100svh;
        background-color: var(--gift-card-bg);
        color: var(--gift-card-text);
      }

      .gift-card__inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 26rem;
        padding: 3rem var(--page-margin);
        text-align: center;
      }

      .gift-card__eyebrow {
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.7;
      }

      .gift-card__title {
        margin-top: 1.25rem;
        font-family: var(--font-price--family);
        font-size: 1.5rem;
        font-weight: 300;
        line-height: 1.2;
      }

      /* The figure is the point of the page, so it's set as one. */
      .gift-card__balance {
        margin-top: 0.5rem;
        font-family: var(--font-price--family);
        font-size: clamp(3rem, 14vw, 4.5rem);
        font-weight: 300;
        line-height: 1;
      }

      .gift-card__initial,
      .gift-card__expiry,
      .gift-card__note {
        margin-top: 0.75rem;
        font-size: 0.9375rem;
        line-height: 1.5;
        opacity: 0.7;
      }

      .gift-card__initial {
        font-family: var(--font-price--family);
        font-size: 1rem;
      }

      .gift-card__expired {
        margin-top: 0.75rem;
        font-size: 0.9375rem;
        font-weight: 600;
        line-height: 1.5;
        color: var(--gift-card-error);
      }

      .gift-card__panel {
        width: 100%;
        margin-top: 2rem;
        padding: 1.5rem 1.25rem;
        background-color: var(--gift-card-panel-bg);
        border: 1px solid var(--gift-card-border);
        border-radius: 2px;
      }

      .gift-card__code-label {
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.6;
      }

      /*
       * Spaced out and monospaced: this is a string somebody has to read off a
       * screen and type into a checkout without a slip.
       */
      .gift-card__code {
        margin-top: 0.625rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 1.25rem;
        line-height: 1.4;
        letter-spacing: 0.12em;
        overflow-wrap: anywhere;
      }

      .gift-card__copy {
        margin-top: 1rem;
        padding: 0.625rem 1.25rem;
        font: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.25;
        color: var(--gift-card-accent);
        cursor: pointer;
        background-color: transparent;
        border: 1px solid var(--gift-card-accent);
        border-radius: var(--style-border-radius-inputs, 2px);
        transition:
          background-color 150ms ease,
          color 150ms ease;
      }

      .gift-card__copy:hover,
      .gift-card__copy:focus-visible {
        color: var(--gift-card-panel-bg);
        background-color: var(--gift-card-accent);
      }

      .gift-card__wallet {
        display: inline-block;
        margin-top: 1.5rem;
      }

      .gift-card__wallet img {
        width: 8.75rem;
        height: auto;
      }

      .gift-card__shop {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 2rem;
        padding: 0.875rem 1.75rem;
        font-weight: 600;
        line-height: 1.25;
        color: #ffffff;
        text-decoration: none;
        background-color: var(--gift-card-accent);
        border-radius: var(--style-border-radius-inputs, 2px);
        transition: opacity 150ms ease;
      }

      .gift-card__shop:hover,
      .gift-card__shop:focus-visible {
        opacity: 0.88;
      }

      /* Printed, the card is the only thing worth putting on paper. */
      @media print {
        .gift-card {
          min-height: 0;
          background-color: transparent;
        }

        .gift-card__copy,
        .gift-card__wallet,
        .gift-card__shop {
          display: none;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main class="gift-card">
      <div class="gift-card__inner">
        <p class="gift-card__eyebrow">{{ shop.name }}</p>

        <h1 class="gift-card__title">{{ 'gift_card.card' | t }}</h1>

        <p class="gift-card__balance">{{ gift_card.balance | money }}</p>

        {%- if is_part_used -%}
          <p class="gift-card__initial">
            {{- 'gift_card.initial_value_html' | t: value: initial_value -}}
          </p>
        {%- endif -%}

        {%- if is_spent -%}
          <p class="gift-card__expired">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="gift-card__expiry">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {%- endif -%}

        <div class="gift-card__panel">
          <p class="gift-card__code-label">{{ 'gift_card.code' | t }}</p>
          <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

          {% # Hidden until the script has confirmed it can actually copy —
             # a button that does nothing is worse than no button. %}
          <button
            type="button"
            class="gift-card__copy"
            hidden
            data-copy="{{ gift_card.code | escape }}"
            data-label="{{ 'gift_card.copy' | t | escape }}"
            data-copied-label="{{ 'gift_card.copied' | t | escape }}"
          >
            {{- 'gift_card.copy' | t -}}
          </button>
        </div>

        {%- unless is_spent -%}
          {% # Nothing to use it for once it's expired or disabled. %}
          <p class="gift-card__note">{{ 'gift_card.use_at_checkout' | t }}</p>
        {%- endunless -%}

        {%- if gift_card.pass_url -%}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t | escape }}"
              width="200"
              height="60"
              loading="lazy"
            >
          </a>
        {%- endif -%}

        <a class="gift-card__shop" href="{{ routes.all_products_collection_url }}">
          {{- 'gift_card.shop' | t -}}
        </a>
      </div>
    </main>

    {% # A template can't carry a javascript tag either, and this is the only
       # script the page needs. %}
    <script>
      (() => {
        const button = document.querySelector('.gift-card__copy');
        if (!button || !navigator.clipboard) return;

        // Only now is the button worth showing.
        button.hidden = false;

        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy);
          } catch (error) {
            // Permission can be refused, and the code is on the page to read
            // either way — so there's nothing to report.
            return;
          }

          button.textContent = button.dataset.copiedLabel;
          window.setTimeout(() => {
            button.textContent = button.dataset.label;
          }, 2000);
        });
      })();
    </script>
  </body>
</html>
